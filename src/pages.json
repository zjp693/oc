{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^wd-(.*)": "@wot-ui/ui/components/wd-$1/wd-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "occ"
			}
		},
		{
			"path": "pages/register/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "注册账号"
			}
		},
		{
			"path": "pages/loading/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "正在加载"
			}
		},
		{
			"path": "pages/home/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "桌面"
			}
		},
		{
			"path": "pages/oc/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "OC"
			}
		},
		{
			"path": "pages/oc-create/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "创建OC"
			}
		},
		{
			"path": "pages/oc-custom-attr-edit/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "自定义子属性编辑详情"
			}
		},
		{
			"path": "pages/oc-detail/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "角色详情"
			}
		},
		{
			"path": "pages/report/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "举报"
			}
		},
		{
			"path": "pages/avatar/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "头像框"
			}
		},
		{
			"path": "pages/manuscript/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "文稿"
			}
		},
		{
			"path": "pages/manuscript-create/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "新增文稿"
			}
		},
		{
			"path": "pages/manuscript-detail/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "文稿详情"
			}
		},
		{
			"path": "pages/manuscript-chapter-create/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "新增章节"
			}
		},
		{
			"path": "pages/manuscript-chapter-edit/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "编辑章节内容"
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "occ",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8",
		"app-plus": {
			"bounce": "none"
		}
	}
}
